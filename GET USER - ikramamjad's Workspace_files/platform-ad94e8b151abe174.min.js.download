      padding: ${e=>e.theme["spacing-xxxl"]} ${e=>e.theme["spacing-zero"]};
    }

    & .migration-ui-illustration {
      padding: ${e=>e.theme["spacing-xl"]} ${e=>e.theme["spacing-zero"]};
    }

    & .migration-ui-progress-message {
      padding: ${e=>e.theme["spacing-xl"]} ${e=>e.theme["spacing-zero"]};
    }

    & .migration-ui-secondary-message {
      padding-bottom: ${e=>e.theme["spacing-xl"]};
    }

    & .progress-bar-container {
      padding-bottom: ${e=>e.theme["spacing-xl"]};

      & .progress-bar {
        width: 320px;
        height: 4px;
        margin: ${e=>e.theme["spacing-zero"]};
        border-radius: 32px;
      }
    }
