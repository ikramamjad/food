        color: ${e=>e.theme["content-color-tertiary"]};
      }

      &:hover {
        border-color: ${e=>e.theme["border-color-strong"]};
      }
    }

    ${e=>{let{validationState:t}=e;return t.status?`
          border-color: ${e.theme[`input-border-color-${t.status}`]};

          &:hover {
            border-color: ${e.theme[`input-border-color-${t.status}`]};
          }

          &--is-focused,
          &--is-focused:hover {
            border-color: ${e.theme["input-border-color-focus"]};;
          }
        `:""}}
  }

  & .aether-multiselect-dropdown__input {
    color: ${e=>e.theme["content-color-primary"]} !important;
    caret-color: ${e=>e.theme["content-color-primary"]};
    height: 16px;
  }

  & .aether-multiselect-dropdown__placeholder {
    color: ${e=>e.theme["content-color-tertiary"]};
  }

  & .aether-multiselect-dropdown__dropdown-indicator {
    svg {
      color: ${e=>e.theme["content-color-secondary"]};
      path {
        fill: ${e=>e.theme["content-color-secondary"]};
      }
    }
    padding: ${e=>`${e.theme["spacing-zero"]} ${e.theme["spacing-s"]};`};
  }

  & .aether-multiselect-dropdown__clear-indicator {
    padding: ${e=>e.theme["spacing-zero"]};
  }
